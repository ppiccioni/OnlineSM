      },
      {
        "name": "Store ID",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_SALES_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.STORE_ID"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "Customer ID",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_SALES_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.CUSTOMER_ID"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "SKU ID",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_SALES_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.SKU_ID"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "Collection ID",
        "dataType": "VARCHAR",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_SALES_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.COLLECTION_ID"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "Channel ID",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_SALES_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.CHANNEL_ID"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "Promotion ID",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_SALES_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.PROMOTION_ID"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "Units Sold",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_SALES_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.QUANTITY"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Primary sales quantity from the base sales fact. Use this as the enterprise sales volume KPI when analyzing sales by date, product, store, customer, channel, promotion, or collection."
      },
      {
        "name": "Gross Sales Amount",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_SALES_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.GROSS_SALES_AMOUNT"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Sales value before discounts, markdowns, returns, or cost deductions."
      },
      {
        "name": "Discount Amount",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_SALES_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.DISCOUNT_AMOUNT"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Total discount or markdown value applied to sales lines."
      },
      {
        "name": "Net Sales Amount",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_SALES_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.NET_SALES_AMOUNT"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Primary sales value after discounts and markdowns. Use this for revenue analysis across the standard business dimensions; it is the cleanest value for dashboard sales trends and comparisons."
      },
      {
        "name": "Cost Amount",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_SALES_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.COST_AMOUNT"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Total standard product cost associated with the sold units."
      },
      {
        "name": "Gross Margin Amount",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_SALES_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.GROSS_MARGIN_AMOUNT"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Net sales minus product cost. Use this to compare profitability across products, stores, channels, and collections."
      },
      {
        "name": "Markdown Pct Raw",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_SALES_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.MARKDOWN_PCT"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "AVG"
        },
        "description": "Raw line-level markdown ratio used as an input to markdown calculations."
      },
      {
        "name": "Full Price Line Count",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_SALES_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.IS_FULL_PRICE"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Number of sales lines sold without markdown."
      },
      {
        "name": "Full Price Units",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_SALES_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1 * %2",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.IS_FULL_PRICE",
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.QUANTITY"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Units sold without markdown. Use this to understand demand quality and whether volume is coming from full-price selling rather than discounting."
      },
      {
        "name": "Returned Line Count",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_SALES_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.IS_RETURNED"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Number of sales lines that later generated a return."
      },
      {
        "name": "Scenario Tag",
        "dataType": "VARCHAR",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_SALES_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES.SCENARIO_TAG"
                ]
              }
            }
          ]
        },
        "description": "Internal data-generation scenario marker; hidden from business-facing analysis.",
        "hideIfTrue": {
          "expressionTemplate": "1 = 1"
        }
      },
      {
        "name": "Sales Line Count",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "LOGICAL_COLUMNS",
          "logicalExpression": {
            "expressionTemplate": "COUNT(DISTINCT %1)",
            "expressionObjects": [
              "logicalColumn:Fashion Retail DW.Sales KPIs.Sales Line ID"
            ]
          }
        },
        "description": "Count of sales lines, useful as a transaction-detail activity measure."
      },
      {
        "name": "Transaction Count",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "LOGICAL_COLUMNS",
          "logicalExpression": {
            "expressionTemplate": "COUNT(DISTINCT %1)",
            "expressionObjects": [
              "logicalColumn:Fashion Retail DW.Sales KPIs.Transaction ID"
            ]
          }
        },
        "description": "Distinct sales transactions represented in the selected context."
      },
      {
        "name": "Average Selling Price",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "LOGICAL_COLUMNS",
          "logicalExpression": {
            "expressionTemplate": "%1 / %2",
            "expressionObjects": [
              "logicalColumn:Fashion Retail DW.Sales KPIs.Net Sales Amount",
              "logicalColumn:Fashion Retail DW.Sales KPIs.Units Sold"
            ]
          }
        },
        "description": "Net sales amount divided by units sold; a proxy for realized price."
      },
      {
        "name": "Gross Margin Pct",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "LOGICAL_COLUMNS",
          "logicalExpression": {
            "expressionTemplate": "%1 / %2 * 100",
            "expressionObjects": [
              "logicalColumn:Fashion Retail DW.Sales KPIs.Gross Margin Amount",
              "logicalColumn:Fashion Retail DW.Sales KPIs.Net Sales Amount"
            ]
          }
        },
        "description": "Gross margin amount as a percentage of net sales amount."
      },
      {
        "name": "Markdown Pct",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "LOGICAL_COLUMNS",
          "logicalExpression": {
            "expressionTemplate": "%1 / %2 * 100",
            "expressionObjects": [
              "logicalColumn:Fashion Retail DW.Sales KPIs.Discount Amount",
              "logicalColumn:Fashion Retail DW.Sales KPIs.Gross Sales Amount"
            ]
          }
        },
        "description": "Discount amount as a percentage of gross sales amount."
      },
      {
        "name": "Return Line Rate",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "LOGICAL_COLUMNS",
          "logicalExpression": {
            "expressionTemplate": "%1 / %2 * 100",
            "expressionObjects": [
              "logicalColumn:Fashion Retail DW.Sales KPIs.Returned Line Count",
              "logicalColumn:Fashion Retail DW.Sales KPIs.Sales Line Count"
            ]
          }
        },
        "description": "Returned sales lines as a percentage of total sales lines."
      },
      {
        "name": "Full Price Line Share",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "LOGICAL_COLUMNS",
          "logicalExpression": {
            "expressionTemplate": "%1 / %2 * 100",
            "expressionObjects": [
              "logicalColumn:Fashion Retail DW.Sales KPIs.Full Price Line Count",
              "logicalColumn:Fashion Retail DW.Sales KPIs.Sales Line Count"
            ]
          }
        },
        "description": "Full-price sales lines as a percentage of total sales lines."
      },
      {
        "name": "Full Price Unit Share Percent",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "LOGICAL_COLUMNS",
          "logicalExpression": {
            "expressionTemplate": "CASE WHEN %2 = 0 THEN 0 ELSE %1 / %2 * 100 END",
            "expressionObjects": [
              "logicalColumn:Fashion Retail DW.Sales KPIs.Full Price Units",
              "logicalColumn:Fashion Retail DW.Sales KPIs.Units Sold"
            ]
          }
        },
        "description": "Full-price units as a percentage of total units sold."
      }
    ],
    "logicalTableSources": [
