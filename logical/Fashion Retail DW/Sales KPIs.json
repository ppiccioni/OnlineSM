        "rightTable": "logicalTable:Fashion Retail DW.Date",
        "joinType": "INNER",
        "cardinality": "MANY_TO_ZERO_OR_ONE"
      },
      {
        "rightTable": "logicalTable:Fashion Retail DW.Store",
        "joinType": "INNER",
        "cardinality": "MANY_TO_ZERO_OR_ONE"
      },
      {
        "rightTable": "logicalTable:Fashion Retail DW.Customer",
        "joinType": "INNER",
        "cardinality": "MANY_TO_ZERO_OR_ONE"
      },
      {
        "rightTable": "logicalTable:Fashion Retail DW.Product",
        "joinType": "INNER",
        "cardinality": "MANY_TO_ZERO_OR_ONE"
      },
      {
        "rightTable": "logicalTable:Fashion Retail DW.Collection",
        "joinType": "INNER",
        "cardinality": "MANY_TO_ZERO_OR_ONE"
      },
      {
        "rightTable": "logicalTable:Fashion Retail DW.Channel",
        "joinType": "INNER",
        "cardinality": "MANY_TO_ZERO_OR_ONE"
      },
      {
        "rightTable": "logicalTable:Fashion Retail DW.Promotion",
        "joinType": "INNER",
        "cardinality": "MANY_TO_ZERO_OR_ONE"
      }
    ]
  }
