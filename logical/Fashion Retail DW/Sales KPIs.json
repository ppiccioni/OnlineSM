        "name": "FACT_SALES_LTS",
        "disable": false,
        "tableMapping": {
          "tables": [
            "physicalTable:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_SALES"
          ]
        },
        "combineWithOtherFragments": false,
        "enableFragmentSelection": false,
        "distinctValues": false
      }
    ],
    "joins": [
