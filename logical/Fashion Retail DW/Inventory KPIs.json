{
  "logicalTable": {
    "name": "Inventory KPIs",
    "description": "Weekly store-SKU inventory measures from FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.",
    "type": "FACT",
    "logicalColumns": [
      {
        "name": "Snapshot Week Start Date",
        "dataType": "DATE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.SNAPSHOT_WEEK_START_DATE"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "Date Key",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.DATE_KEY"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "Store ID",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.STORE_ID"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "SKU ID",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.SKU_ID"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "Collection ID",
        "dataType": "VARCHAR",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.COLLECTION_ID"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "On Hand Units",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.ON_HAND_UNITS"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Total physical stock on hand at store-SKU-week grain."
      },
      {
        "name": "Available Units",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.AVAILABLE_UNITS"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Units available for sale after reservations or unavailable stock."
      },
      {
        "name": "Reserved Units",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.RESERVED_UNITS"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Units reserved and not immediately available for sale."
      },
      {
        "name": "Stockout Count",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.STOCKOUT_FLAG"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Count of store-SKU snapshots flagged as stockout."
      },
      {
        "name": "Inventory Value At Cost",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.INVENTORY_VALUE_AT_COST"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Inventory value calculated using standard product cost."
      },
      {
        "name": "Average Weeks Of Supply",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.WEEKS_OF_SUPPLY"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "AVG"
        },
        "description": "Average estimated weeks of supply based on stock and demand."
      },
      {
        "name": "Average Store-SKU Overstock Risk Index",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.OVERSTOCK_RISK_SCORE"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "AVG"
        },
        "description": "Historical average raw overstock risk index at store-SKU-week grain; not scaled to 0-100."
      },
      {
        "name": "Average Store-SKU Stockout Risk Index",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.STOCKOUT_RISK_SCORE"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "AVG"
        },
        "description": "Historical average raw stockout risk index at store-SKU-week grain; not scaled to 0-100."
      },
      {
        "name": "Raw Store-SKU Stockout Risk Index",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.STOCKOUT_RISK_SCORE"
                ]
              }
            }
          ]
        },
        "description": "Hidden raw store-SKU stockout risk index used to calculate the current 0-100 score."
      },
      {
        "name": "Raw Store-SKU Overstock Risk Index",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.OVERSTOCK_RISK_SCORE"
                ]
              }
            }
          ]
        },
        "description": "Hidden raw store-SKU overstock risk index used to calculate the current 0-100 score."
      },
      {
        "name": "Current Store-SKU Stockout Risk Score",
        "description": "Latest-week store-SKU stockout risk rescaled to a 0-100 dashboard score; supports Store and Region filtering.",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "LOGICAL_COLUMNS",
          "logicalExpression": {
            "expressionTemplate": "EVALUATE_AGGR('AVG(\\%1) KEEP (DENSE_RANK LAST ORDER BY \\%2)' AS DOUBLE, %1, %2) * 100",
            "expressionObjects": [
              "logicalColumn:Fashion Retail DW.Inventory KPIs.Raw Store-SKU Stockout Risk Index",
              "logicalColumn:Fashion Retail DW.Inventory KPIs.Snapshot Week Start Date"
            ]
          }
        }
      },
      {
        "name": "Current Store-SKU Overstock Risk Score",
        "description": "Latest-week store-SKU overstock risk rescaled to a 0-100 dashboard score; supports Store and Region filtering.",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "LOGICAL_COLUMNS",
          "logicalExpression": {
            "expressionTemplate": "EVALUATE_AGGR('AVG(\\%1) KEEP (DENSE_RANK LAST ORDER BY \\%2)' AS DOUBLE, %1, %2) * 100",
            "expressionObjects": [
              "logicalColumn:Fashion Retail DW.Inventory KPIs.Raw Store-SKU Overstock Risk Index",
              "logicalColumn:Fashion Retail DW.Inventory KPIs.Snapshot Week Start Date"
            ]
          }
        }
      },
      {
        "name": "Scenario Tag",
        "dataType": "VARCHAR",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.SCENARIO_TAG"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "Available Unit Share",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "LOGICAL_COLUMNS",
          "logicalExpression": {
            "expressionTemplate": "CASE WHEN %2 = 0 THEN 0 ELSE %1 / %2 * 100 END",
            "expressionObjects": [
              "logicalColumn:Fashion Retail DW.Inventory KPIs.Available Units",
              "logicalColumn:Fashion Retail DW.Inventory KPIs.On Hand Units"
            ]
          }
        },
        "description": "Available units as a percentage of on-hand units."
      }
    ],
    "logicalTableSources": [
      {
        "name": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
        "disable": false,
        "tableMapping": {
          "tables": [
            "physicalTable:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY"
          ]
        },
        "combineWithOtherFragments": false,
        "enableFragmentSelection": false,
        "distinctValues": false
      }
    ],
    "joins": [
      {
        "rightTable": "logicalTable:Fashion Retail DW.Date",
        "joinType": "INNER",
        "cardinality": "MANY_TO_ZERO_OR_ONE"
      },
      {
        "rightTable": "logicalTable:Fashion Retail DW.Store",
        "joinType": "INNER",
        "cardinality": "MANY_TO_ZERO_OR_ONE"
      },
      {
        "rightTable": "logicalTable:Fashion Retail DW.Product",
        "joinType": "INNER",
        "cardinality": "MANY_TO_ZERO_OR_ONE"
      },
      {
        "rightTable": "logicalTable:Fashion Retail DW.Collection",
        "joinType": "INNER",
        "cardinality": "MANY_TO_ZERO_OR_ONE"
      }
    ]
  }
}
