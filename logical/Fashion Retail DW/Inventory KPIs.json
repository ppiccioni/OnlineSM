{
  "logicalTable": {
    "name": "Inventory KPIs",
    "description": "Weekly store-SKU inventory measures from FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.",
    "type": "FACT",
    "logicalColumns": [
      {
        "name": "Snapshot Week Start Date",
        "dataType": "DATE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.SNAPSHOT_WEEK_START_DATE"
                ]
              }
            }
          ]
        },
        "description": "Week represented by the base inventory snapshot. Include it when analyzing inventory history or validating latest-known inventory status."
      },
      {
        "name": "Date Key",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.DATE_KEY"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "Store ID",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.STORE_ID"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "SKU ID",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.SKU_ID"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "Collection ID",
        "dataType": "VARCHAR",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.COLLECTION_ID"
                ]
              }
            }
          ]
        }
      },
      {
        "name": "Snapshot On Hand Units",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.ON_HAND_UNITS"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Physical stock on hand in the weekly inventory snapshot at store-SKU-week grain. Use it for point-in-time operational inventory reporting; use Inventory Movement KPIs for opening-to-ending flow analysis."
      },
      {
        "name": "Snapshot Available Units",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.AVAILABLE_UNITS"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Sellable units in the weekly inventory snapshot after reservations or unavailable stock are excluded. Use it for point-in-time availability reporting."
      },
      {
        "name": "Snapshot Reserved Units",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.RESERVED_UNITS"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Reserved units in the weekly inventory snapshot that are physically on hand but not immediately sellable."
      },
      {
        "name": "Raw Store-SKU On Hand Units",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.ON_HAND_UNITS"
                ]
              }
            }
          ]
        },
        "description": "Hidden raw on_hand_units value used by latest-week inventory status measures.",
        "hideIfTrue": {
          "expressionTemplate": "1 = 1"
        }
      },
      {
        "name": "Latest Known Store-SKU On Hand Units",
        "description": "Last known physical stock on hand at store-SKU grain. Use this with the snapshot week to understand store availability when a SKU is not present in every weekly inventory snapshot.",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "LOGICAL_COLUMNS",
          "logicalExpression": {
            "expressionTemplate": "EVALUATE_AGGR('SUM(\\%1) KEEP (DENSE_RANK LAST ORDER BY \\%2)' AS DOUBLE, %1, %2)",
            "expressionObjects": [
              "logicalColumn:Fashion Retail DW.Inventory KPIs.Raw Store-SKU On Hand Units",
              "logicalColumn:Fashion Retail DW.Inventory KPIs.Snapshot Week Start Date"
            ]
          }
        }
      },
      {
        "name": "Raw Store-SKU Available Units",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.AVAILABLE_UNITS"
                ]
              }
            }
          ]
        },
        "description": "Hidden raw available_units value used by latest-week inventory status measures.",
        "hideIfTrue": {
          "expressionTemplate": "1 = 1"
        }
      },
      {
        "name": "Latest Known Store-SKU Available Units",
        "description": "Last known sellable inventory at store-SKU grain after reservations and unavailable stock. Use this with the snapshot week to identify possible transfer candidates and judge how fresh the inventory status is.",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "LOGICAL_COLUMNS",
          "logicalExpression": {
            "expressionTemplate": "EVALUATE_AGGR('SUM(\\%1) KEEP (DENSE_RANK LAST ORDER BY \\%2)' AS DOUBLE, %1, %2)",
            "expressionObjects": [
              "logicalColumn:Fashion Retail DW.Inventory KPIs.Raw Store-SKU Available Units",
              "logicalColumn:Fashion Retail DW.Inventory KPIs.Snapshot Week Start Date"
            ]
          }
        }
      },
      {
        "name": "Raw Store-SKU Reserved Units",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.RESERVED_UNITS"
                ]
              }
            }
          ]
        },
        "description": "Hidden raw reserved_units value used by latest-week inventory status measures.",
        "hideIfTrue": {
          "expressionTemplate": "1 = 1"
        }
      },
      {
        "name": "Latest Known Store-SKU Reserved Units",
        "description": "Last known reserved inventory at store-SKU grain. Use this beside latest known available units to understand why on-hand stock may not be fully transferable.",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "LOGICAL_COLUMNS",
          "logicalExpression": {
            "expressionTemplate": "EVALUATE_AGGR('SUM(\\%1) KEEP (DENSE_RANK LAST ORDER BY \\%2)' AS DOUBLE, %1, %2)",
            "expressionObjects": [
              "logicalColumn:Fashion Retail DW.Inventory KPIs.Raw Store-SKU Reserved Units",
              "logicalColumn:Fashion Retail DW.Inventory KPIs.Snapshot Week Start Date"
            ]
          }
        }
      },
      {
        "name": "Snapshot Stockout Count",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.STOCKOUT_FLAG"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Count of weekly store-SKU snapshots flagged as stockout. This is an operational snapshot count, not an AI alert count."
      },
      {
        "name": "Snapshot Inventory Value At Cost",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.INVENTORY_VALUE_AT_COST"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "SUM"
        },
        "description": "Inventory value at standard cost for the weekly inventory snapshot."
      },
      {
        "name": "Average Snapshot Weeks Of Supply",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.WEEKS_OF_SUPPLY"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "AVG"
        },
        "description": "Average estimated weeks of supply across weekly inventory snapshots in the selected context."
      },
      {
        "name": "Average Store-SKU Overstock Risk Index",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.OVERSTOCK_RISK_SCORE"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "AVG"
        },
        "description": "Historical average raw overstock risk index at store-SKU-week grain; not scaled to 0-100."
      },
      {
        "name": "Average Store-SKU Stockout Risk Index",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.STOCKOUT_RISK_SCORE"
                ]
              }
            }
          ]
        },
        "aggregation": {
          "rule": "AVG"
        },
        "description": "Historical average raw stockout risk index at store-SKU-week grain; not scaled to 0-100."
      },
      {
        "name": "Raw Store-SKU Stockout Risk Index",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.STOCKOUT_RISK_SCORE"
                ]
              }
            }
          ]
        },
        "description": "Hidden raw store-SKU stockout risk index used to calculate the current 0-100 score."
      },
      {
        "name": "Raw Store-SKU Overstock Risk Index",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.OVERSTOCK_RISK_SCORE"
                ]
              }
            }
          ]
        },
        "description": "Hidden raw store-SKU overstock risk index used to calculate the current 0-100 score."
      },
      {
        "name": "Current Store-SKU Stockout Risk Score",
        "description": "Latest-week store-SKU stockout risk rescaled to a 0-100 dashboard score. Use this for current inventory risk because it avoids diluting the latest state with older weeks.",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "LOGICAL_COLUMNS",
          "logicalExpression": {
            "expressionTemplate": "EVALUATE_AGGR('AVG(\\%1) KEEP (DENSE_RANK LAST ORDER BY \\%2)' AS DOUBLE, %1, %2) * 100",
            "expressionObjects": [
              "logicalColumn:Fashion Retail DW.Inventory KPIs.Raw Store-SKU Stockout Risk Index",
              "logicalColumn:Fashion Retail DW.Inventory KPIs.Snapshot Week Start Date"
            ]
          }
        }
      },
      {
        "name": "Current Store-SKU Overstock Risk Score",
        "description": "Latest-week store-SKU overstock risk rescaled to a 0-100 dashboard score. Use this for current overstock monitoring because it reflects the latest available inventory snapshot.",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "LOGICAL_COLUMNS",
          "logicalExpression": {
            "expressionTemplate": "EVALUATE_AGGR('AVG(\\%1) KEEP (DENSE_RANK LAST ORDER BY \\%2)' AS DOUBLE, %1, %2) * 100",
            "expressionObjects": [
              "logicalColumn:Fashion Retail DW.Inventory KPIs.Raw Store-SKU Overstock Risk Index",
              "logicalColumn:Fashion Retail DW.Inventory KPIs.Snapshot Week Start Date"
            ]
          }
        }
      },
      {
        "name": "Scenario Tag",
        "dataType": "VARCHAR",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "PHYSICAL_COLUMNS",
          "physicalMappings": [
            {
              "logicalTableSource": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
              "physicalExpression": {
                "expressionTemplate": "%1",
                "expressionObjects": [
                  "physicalColumn:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY.SCENARIO_TAG"
                ]
              }
            }
          ]
        },
        "description": "Internal data-generation scenario marker; hidden from business-facing analysis.",
        "hideIfTrue": {
          "expressionTemplate": "1 = 1"
        }
      },
      {
        "name": "Snapshot Available Unit Share",
        "dataType": "DOUBLE",
        "writeable": false,
        "logicalColumnSource": {
          "derivedFrom": "LOGICAL_COLUMNS",
          "logicalExpression": {
            "expressionTemplate": "CASE WHEN %2 = 0 THEN 0 ELSE %1 / %2 * 100 END",
            "expressionObjects": [
              "logicalColumn:Fashion Retail DW.Inventory KPIs.Snapshot Available Units",
              "logicalColumn:Fashion Retail DW.Inventory KPIs.Snapshot On Hand Units"
            ]
          }
        },
        "description": "Snapshot available units as a percentage of snapshot on-hand units."
      }
    ],
    "logicalTableSources": [
      {
        "name": "FACT_INVENTORY_SNAPSHOT_WEEKLY_LTS",
        "disable": false,
        "tableMapping": {
          "tables": [
            "physicalTable:FashionDW.CAT_FASHIONDW.FASHIONDW.FACT_INVENTORY_SNAPSHOT_WEEKLY"
          ]
        },
        "combineWithOtherFragments": false,
        "enableFragmentSelection": false,
        "distinctValues": false
      }
    ],
    "joins": [
      {
        "rightTable": "logicalTable:Fashion Retail DW.Date",
        "joinType": "INNER",
        "cardinality": "MANY_TO_ZERO_OR_ONE"
      },
      {
        "rightTable": "logicalTable:Fashion Retail DW.Store",
        "joinType": "INNER",
        "cardinality": "MANY_TO_ZERO_OR_ONE"
      },
      {
        "rightTable": "logicalTable:Fashion Retail DW.Product",
        "joinType": "INNER",
        "cardinality": "MANY_TO_ZERO_OR_ONE"
      },
      {
        "rightTable": "logicalTable:Fashion Retail DW.Collection",
        "joinType": "INNER",
        "cardinality": "MANY_TO_ZERO_OR_ONE"
      }
    ]
  }
}
